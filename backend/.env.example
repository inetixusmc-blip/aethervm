GOOGLE_WEB_CLIENT_ID=636307355753-srlt103so2e3d1encolqo0nq1tjrtk2v.apps.googleusercontent.com
SANDBOX_PROVIDER=daytona
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
# Leave empty to use aethervm-ubuntu-24-04-v1. Custom snapshots must be Ubuntu 24.04.
DAYTONA_SNAPSHOT=
DB_PATH=aethervm.sqlite3
# Dev login is disabled by default. NEVER enable on a public server.
DEV_AUTH=false
# For ephemeral free hosting, create a libSQL database (not the new Turso engine).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Restrict the personal deployment to your Google account.
ALLOWED_GOOGLE_EMAILS=inetixus@gmail.com
