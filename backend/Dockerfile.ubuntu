FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:0 VNC_RESOLUTION=1280x800
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git sudo python3 python3-pip python3-venv nodejs npm \
    xvfb xfce4 xfce4-terminal x11vnc novnc websockify dbus-x11 xauth xdotool \
    libx11-6 libxrandr2 libxext6 libxrender1 libxfixes3 libxss1 libxtst6 libxi6 \
    yaru-theme-gtk yaru-theme-icon arc-theme fonts-ubuntu fonts-dejavu-core \
    mousepad thunar ffmpeg unzip zip xdg-utils scrot && rm -rf /var/lib/apt/lists/*
# Ubuntu's chromium package needs snap; use the official Chrome Debian package.
RUN curl -fsSLo /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    && apt-get update && apt-get install -y /tmp/chrome.deb \
    && rm /tmp/chrome.deb && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash daytona && mkdir /workspace && chown daytona:daytona /workspace \
    && echo 'daytona ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/daytona && chmod 440 /etc/sudoers.d/daytona
USER daytona
WORKDIR /workspace
RUN python3 -m venv /home/daytona/.venv && /home/daytona/.venv/bin/pip install --no-cache-dir playwright \
    && /home/daytona/.venv/bin/playwright install chromium
ENV PATH=/home/daytona/.venv/bin:$PATH
CMD ["sleep", "infinity"]
