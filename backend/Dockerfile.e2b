FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:0
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git sudo python3 python3-pip python3-venv nodejs npm \
    xvfb x11-utils x11-xserver-utils xfce4 xfce4-terminal x11vnc novnc websockify \
    dbus-x11 xauth xdotool scrot procps util-linux fonts-ubuntu fonts-dejavu-core \
    yaru-theme-gtk yaru-theme-icon arc-theme mousepad thunar ffmpeg unzip zip xdg-utils \
    && rm -rf /var/lib/apt/lists/*
# Shared, readable paths avoid home/PATH changes in commands and SDK sessions.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/aethervm-browsers
RUN python3 -m venv /opt/aethervm-venv \
    && /opt/aethervm-venv/bin/pip install --no-cache-dir playwright==1.61.0 \
    && /opt/aethervm-venv/bin/playwright install --with-deps chromium \
    && chmod -R a+rX /opt/aethervm-venv /opt/aethervm-browsers
RUN id user >/dev/null 2>&1 || useradd -m -s /bin/bash user
RUN mkdir -p /workspace && chown user:user /workspace \
    && echo 'user ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/aether-user \
    && chmod 440 /etc/sudoers.d/aether-user
ENV PATH=/opt/aethervm-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
USER user
WORKDIR /workspace
